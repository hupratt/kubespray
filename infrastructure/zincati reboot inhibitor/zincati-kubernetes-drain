#!/usr/bin/env bash

# /usr/local/bin/zincati-kubernetes-drain

set -Eeuo pipefail

NODE="$(hostname -s)"
DRAIN_TIMEOUT="${DRAIN_TIMEOUT:-10m}"

log() {
    logger -t zincati-kubernetes-drain -- "$*"
    echo "[$(date --iso-8601=seconds)] $*"
}

drain() {
    log "Zincati/systemd reboot detected"
    log "Cordoning Kubernetes node ${NODE}"

    kubectl cordon "${NODE}"

    log "Draining Kubernetes node ${NODE}"

    kubectl drain "${NODE}" \
        --ignore-daemonsets \
        --delete-emptydir-data \
        --grace-period=60 \
        --timeout="${DRAIN_TIMEOUT}"

    log "Kubernetes node ${NODE} successfully drained"
}

trap drain SIGTERM SIGINT

log "Starting Kubernetes drain inhibitor"

exec systemd-inhibit \
    --what=reboot \
    --mode=delay \
    --who="zincati-kubernetes-drain" \
    --why="Drain Kubernetes workloads before reboot" \
    sleep infinity