fullnameOverride: {{ netbird_release }}

{% if haproxy_ingress_flavor == "jcmoraisjr" %}
{% set grpc_annotations = {
  "cert-manager.io/cluster-issuer": haproxy_cert_issuer,
  "haproxy-ingress.github.io/backend-protocol": "h2",
  "haproxy-ingress.github.io/ssl-redirect": "true",
  "haproxy-ingress.github.io/timeout-server": "3600s",
  "haproxy-ingress.github.io/timeout-tunnel": "3600s",
} %}
{% set http_annotations = {
  "cert-manager.io/cluster-issuer": haproxy_cert_issuer,
  "haproxy-ingress.github.io/ssl-redirect": "true",
} %}
{% else %}
{% set grpc_annotations = {
  "cert-manager.io/cluster-issuer": haproxy_cert_issuer,
  "haproxy.org/server-proto": "h2",
  "haproxy.org/ssl-redirect": "true",
  "haproxy.org/timeout-tunnel": "3600s",
} %}
{% set http_annotations = {
  "cert-manager.io/cluster-issuer": haproxy_cert_issuer,
  "haproxy.org/ssl-redirect": "true",
} %}
{% endif %}

management:
  configmap: |-
    {
      "Stuns": [
        {
          "Proto": "udp",
          "URI": "stun:{{ netbird_stun_domain }}:3478",
          "Username": "",
          "Password": ""
        }
      ],
      "TURNConfig": {
        "TimeBasedCredentials": true,
        "CredentialsTTL": "24h0m0s",
        "Secret": "{{ '{{ .TURN_SECRET }}' }}",
        "Turns": [
          {
            "Proto": "udp",
            "URI": "turn:{{ netbird_stun_domain }}:3478",
            "Username": "",
            "Password": ""
          }
        ]
      },
      "Relay": {
        "Addresses": ["rels://{{ netbird_domain }}:443/relay"],
        "CredentialsTTL": "24h",
        "Secret": "{{ '{{ .RELAY_PASSWORD }}' }}"
      },
      "Signal": {
        "Proto": "https",
        "URI": "{{ netbird_domain }}:443",
        "Username": "",
        "Password": ""
      },
      "Datadir": "/var/lib/netbird/",
      "DataStoreEncryptionKey": "{{ '{{ .DATASTORE_ENCRYPTION_KEY }}' }}",
      "HttpConfig": {
        "LetsEncryptDomain": "",
        "CertFile": "",
        "CertKey": "",
        "AuthAudience": "{{ '{{ .IDP_CLIENT_ID }}' }}",
        "AuthIssuer": "{{ idp_base_url }}/",
        "AuthUserIDClaim": "",
        "AuthKeysLocation": "{{ idp_base_url }}/jwks/",
        "OIDCConfigEndpoint": "{{ idp_base_url }}/.well-known/openid-configuration",
        "IdpSignKeyRefreshEnabled": false
      },
      "IdpManagerConfig": {
        "ManagerType": "{{ idp_manager_type }}",
        "ClientConfig": {
          "Issuer": "{{ idp_base_url }}",
          "TokenEndpoint": "{{ idp_base_url | regex_replace('/o/[^/]+$', '/o/token/') }}",
          "ClientID": "{{ '{{ .IDP_CLIENT_ID }}' }}",
          "ClientSecret": "{{ '{{ .IDP_CLIENT_SECRET }}' }}",
          "GrantType": "client_credentials"
        },
        "ExtraConfig": {
          "Username": "{{ '{{ .IDP_SERVICE_ACCOUNT_USER }}' }}",
          "Password": "{{ '{{ .IDP_SERVICE_ACCOUNT_PASSWORD }}' }}"
        },
        "Auth0ClientCredentials": null,
        "AzureClientCredentials": null,
        "KeycloakClientCredentials": null,
        "ZitadelClientCredentials": null
      },
      "DeviceAuthorizationFlow": {
        "Provider": "hosted",
        "ProviderConfig": {
          "ClientID": "{{ '{{ .IDP_CLIENT_ID }}' }}",
          "ClientSecret": "{{ '{{ .IDP_CLIENT_SECRET }}' }}",
          "Domain": "{{ idp_base_url }}",
          "Audience": "{{ '{{ .IDP_CLIENT_ID }}' }}",
          "TokenEndpoint": "{{ idp_base_url | regex_replace('/o/[^/]+$', '/o/token/') }}",
          "DeviceAuthEndpoint": "{{ idp_base_url | regex_replace('/o/[^/]+$', '/o/device/') }}",
          "AuthorizationEndpoint": "",
          "Scope": "openid",
          "UseIDToken": false,
          "RedirectURLs": null
        }
      },
      "PKCEAuthorizationFlow": {
        "ProviderConfig": {
          "ClientID": "{{ '{{ .IDP_CLIENT_ID }}' }}",
          "ClientSecret": "",
          "Domain": "",
          "Audience": "{{ '{{ .IDP_CLIENT_ID }}' }}",
          "TokenEndpoint": "{{ idp_base_url | regex_replace('/o/[^/]+$', '/o/token/') }}",
          "DeviceAuthEndpoint": "",
          "AuthorizationEndpoint": "{{ idp_base_url | regex_replace('/o/[^/]+$', '/o/authorize/') }}",
          "Scope": "openid profile email offline_access api",
          "UseIDToken": false,
          "RedirectURLs": ["http://localhost:53000"]
        }
      },
      "StoreConfig": {
        "Engine": "{{ 'postgres' if netbird_use_postgres else 'sqlite' }}"
      },
      "ReverseProxy": {
        "TrustedHTTPProxies": null,
        "TrustedHTTPProxiesCount": 0,
        "TrustedPeers": null
      }
    }

  persistentVolume:
    enabled: {{ 'false' if netbird_use_postgres else 'true' }}

  envFromSecret:
{% if netbird_use_postgres %}
    NETBIRD_STORE_ENGINE_POSTGRES_DSN: netbird/postgresDSN
{% endif %}
    TURN_SECRET: netbird/turnServerPassword
    RELAY_PASSWORD: netbird/relayPassword
    IDP_CLIENT_ID: netbird/idpClientID
    IDP_CLIENT_SECRET: netbird/idpClientSecret
    IDP_SERVICE_ACCOUNT_USER: netbird/idpServiceAccountUser
    IDP_SERVICE_ACCOUNT_PASSWORD: netbird/idpServiceAccountPassword
    DATASTORE_ENCRYPTION_KEY: netbird/datastoreEncryptionKey

  useBackwardsGrpcService: true

  ingress:
    enabled: true
    className: {{ haproxy_ingress_class }}
    annotations:
{% for k, v in http_annotations.items() %}
      {{ k }}: "{{ v }}"
{% endfor %}
    hosts:
      - host: {{ netbird_domain }}
        paths:
          - path: /api
            pathType: ImplementationSpecific
    tls:
      - secretName: netbird-api-tls
        hosts:
          - {{ netbird_domain }}

  ingressGrpc:
    enabled: true
    className: {{ haproxy_ingress_class }}
    annotations:
{% for k, v in grpc_annotations.items() %}
      {{ k }}: "{{ v }}"
{% endfor %}
    hosts:
      - host: {{ netbird_domain }}
        paths:
          - path: /management.ManagementService
            pathType: ImplementationSpecific
    tls:
      - secretName: netbird-grpc-tls
        hosts:
          - {{ netbird_domain }}

signal:
  ingress:
    enabled: true
    className: {{ haproxy_ingress_class }}
    annotations:
{% for k, v in grpc_annotations.items() %}
      {{ k }}: "{{ v }}"
{% endfor %}
    hosts:
      - host: {{ netbird_domain }}
        paths:
          - path: /signalexchange.SignalExchange
            pathType: ImplementationSpecific
    tls:
      - secretName: netbird-signal-tls
        hosts:
          - {{ netbird_domain }}

relay:
  envFromSecret:
    NB_AUTH_SECRET: netbird/relayPassword
  env:
    NB_LOG_LEVEL: info
    NB_LISTEN_ADDRESS: ":33080"
    NB_EXPOSED_ADDRESS: "rels://{{ netbird_domain }}:443/relay"
  ingress:
    enabled: true
    className: {{ haproxy_ingress_class }}
    annotations:
{% for k, v in http_annotations.items() %}
      {{ k }}: "{{ v }}"
{% endfor %}
    hosts:
      - host: {{ netbird_domain }}
        paths:
          - path: /relay
            pathType: ImplementationSpecific
    tls:
      - secretName: netbird-relay-tls
        hosts:
          - {{ netbird_domain }}

dashboard:
  enabled: true

  livenessProbe:
    httpGet:
      path: /
      port: 80
    initialDelaySeconds: 15
    periodSeconds: 20
  readinessProbe:
    httpGet:
      path: /
      port: 80
    initialDelaySeconds: 5
    periodSeconds: 10
  env:
    NETBIRD_MGMT_API_ENDPOINT: "https://{{ netbird_domain }}:443"
    NETBIRD_MGMT_GRPC_API_ENDPOINT: "https://{{ netbird_domain }}:443"
    AUTH_AUTHORITY: "{{ idp_base_url }}/"
    USE_AUTH0: "false"
    AUTH_SUPPORTED_SCOPES: "openid profile email offline_access api"
    AUTH_REDIRECT_URI: "/oauth2/callback"
    AUTH_SILENT_REDIRECT_URI: ""
    NETBIRD_TOKEN_SOURCE: accessToken
    NGINX_SSL_PORT: ""
    LETSENCRYPT_DOMAIN: ""
    LETSENCRYPT_EMAIL: ""
  envFromSecret:
    AUTH_CLIENT_ID: netbird/idpClientID
    AUTH_AUDIENCE: netbird/idpClientID
    AUTH_CLIENT_SECRET: netbird/idpClientSecret
  ingress:
    enabled: true
    className: {{ haproxy_ingress_class }}
    annotations:
{% for k, v in http_annotations.items() %}
      {{ k }}: "{{ v }}"
{% endfor %}
    hosts:
      - host: {{ netbird_dashboard_domain }}
        paths:
          - path: /
            pathType: ImplementationSpecific
    tls:
      - secretName: netbird-dashboard-tls
        hosts:
          - {{ netbird_dashboard_domain }}