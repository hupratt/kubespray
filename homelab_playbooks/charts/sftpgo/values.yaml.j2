  SFTPGO_COMMON_DEFENDER__THRESHOLD: "{{ authentik_secret.resources[0].data.SFTPGO_COMMON_DEFENDER__THRESHOLD | b64decode }}"
  SFTPGO_COMMON_DEFENDER__OBSERVATION_TIME: "{{ authentik_secret.resources[0].data.SFTPGO_COMMON_DEFENDER__OBSERVATION_TIME | b64decode }}"
