  SFTPGO_HTTPD__BINDINGS__0__OIDC__CLIENT_ID: "{{ authentik_secret.resources[0].data.SFTPGO_HTTPD__BINDINGS__0__OIDC__CLIENT_ID | b64decode }}"
  SFTPGO_HTTPD__BINDINGS__0__OIDC__CLIENT_SECRET: "{{ authentik_secret.resources[0].data.SFTPGO_HTTPD__BINDINGS__0__OIDC__CLIENT_SECRET | b64decode }}"
  SFTPGO_HTTPD__BINDINGS__0__OIDC__CONFIG_URL: "{{ authentik_secret.resources[0].data.SFTPGO_HTTPD__BINDINGS__0__OIDC__CONFIG_URL | b64decode }}"
  SFTPGO_HTTPD__BINDINGS__0__OIDC__REDIRECT_BASE_URL: "{{ authentik_secret.resources[0].data.SFTPGO_HTTPD__BINDINGS__0__OIDC__REDIRECT_BASE_URL | b64decode }}"
  SFTPGO_HTTPD__BINDINGS__0__OIDC__USERNAME_FIELD: "{{ authentik_secret.resources[0].data.SFTPGO_HTTPD__BINDINGS__0__OIDC__USERNAME_FIELD | b64decode }}"
# -- Pod [security context](https://kubernetes.io/docs/tasks/configure-pod-container/security-context/#set-the-security-context-for-a-pod).
