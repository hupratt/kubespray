  SFTPGO_FTPD__BINDINGS__0__ADDRESS: "{{ authentik_secret.resources[0].data.SFTPGO_FTPD__BINDINGS__0__ADDRESS | b64decode }}"
  SFTPGO_FTPD__BINDINGS__0__TLS_MODE: "{{ authentik_secret.resources[0].data.SFTPGO_FTPD__BINDINGS__0__TLS_MODE | b64decode }}"
  SFTPGO_FTPD__BINDINGS__0__DEBUG: "{{ authentik_secret.resources[0].data.SFTPGO_FTPD__BINDINGS__0__DEBUG | b64decode }}"
  SFTPGO_FTPD__PASSIVE_PORT_RANGE__START: "{{ authentik_secret.resources[0].data.SFTPGO_FTPD__PASSIVE_PORT_RANGE__START | b64decode }}"
  SFTPGO_FTPD__PASSIVE_PORT_RANGE__END: "{{ authentik_secret.resources[0].data.SFTPGO_FTPD__PASSIVE_PORT_RANGE__END | b64decode }}"
  SFTPGO_FTPD__DISABLE_ACTIVE_MODE: "{{ authentik_secret.resources[0].data.SFTPGO_FTPD__DISABLE_ACTIVE_MODE | b64decode }}"
#      SFTPGO_FTPD__BINDINGS__0__PORT: 2121
  SFTPGO_WEBDAVD__BINDINGS__0__PORT: "{{ authentik_secret.resources[0].data.SFTPGO_WEBDAVD__BINDINGS__0__PORT | b64decode }}"
  SFTPGO_DATA_PROVIDER__DRIVER: "{{ authentik_secret.resources[0].data.SFTPGO_DATA_PROVIDER__DRIVER | b64decode }}"
  SFTPGO_DATA_PROVIDER__NAME: "{{ authentik_secret.resources[0].data.SFTPGO_DATA_PROVIDER__NAME | b64decode }}"
  SFTPGO_DATA_PROVIDER__HOST: "{{ authentik_secret.resources[0].data.SFTPGO_DATA_PROVIDER__HOST | b64decode }}"
  SFTPGO_DATA_PROVIDER__PORT: "{{ authentik_secret.resources[0].data.SFTPGO_DATA_PROVIDER__PORT | b64decode }}"
  SFTPGO_DATA_PROVIDER__USERNAME: "{{ authentik_secret.resources[0].data.SFTPGO_DATA_PROVIDER__USERNAME | b64decode }}"
  SFTPGO_DATA_PROVIDER__PASSWORD: "{{ authentik_secret.resources[0].data.SFTPGO_DATA_PROVIDER__PASSWORD | b64decode }}"
  SFTPGO_COMMON_DEFENDER__ENABLED: "{{ authentik_secret.resources[0].data.SFTPGO_COMMON_DEFENDER__ENABLED | b64decode }}"
  SFTPGO_COMMON_DEFENDER__BAN_TIME: "{{ authentik_secret.resources[0].data.SFTPGO_COMMON_DEFENDER__BAN_TIME | b64decode }}"
