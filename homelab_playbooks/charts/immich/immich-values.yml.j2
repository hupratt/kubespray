{# templates/immich-values.yml.j2 #}

immich:
  metrics:
    enabled: true
  persistence:
    library:
      existingClaim: immich-library
persistence:
  data:
    globalMounts:
      - path: /usr/src/app/upload

# ── Shared DB/Redis env (top-level controllers = immich server) ───────────────
controllers:
  main:
    containers:
      main:
        image:
          tag: ""   # follow chart appVersion
        env:
          REDIS_HOSTNAME: "{% raw %}{{ printf \"%s-valkey\" .Release.Name }}{% endraw %}"
          IMMICH_MACHINE_LEARNING_URL: "{% raw %}{{ printf \"http://%s-machine-learning:3003\" .Release.Name }}{% endraw %}"
          DB_HOSTNAME: "immich-pg-rw.{{ immich_namespace }}.svc"
          DB_PORT: "5432"
          DB_DATABASE_NAME: immich
        envFrom:
          - secretRef:
              name: immich-app-secret   # DATABASE_URL, DB_USERNAME, DB_PASSWORD from Vault

# ── Server ────────────────────────────────────────────────────────────────────
server:
  enabled: true
  controllers:
    main:
      pod:
        nodeSelector:
          node-role: slow-services
        tolerations:
          - key: dedicated
            operator: Equal
            value: slow-services
            effect: NoSchedule
        securityContext:
          fsGroup: 1000
          runAsUser: 1000
          runAsNonRoot: true
      replicas: 1
      nodeSelector:
        node-role: slow-services
      tolerations:
        - key: dedicated
          operator: Equal
          value: slow-services
          effect: NoSchedule
      containers:
        main:
          env:
            TZ: Europe/Berlin
          image:
            tag: "v2.7.5"
          resources:
            requests:
              cpu: 100m
              memory: 512Mi
            limits:
              memory: 2Gi
          securityContext:
            runAsNonRoot: true
            runAsUser: 1000
  ingress:
    main:
      enabled: true
      ingressClassName: haproxy
      hosts:
        - host: immich.thekor.eu
          paths:
            - path: /
              service:
                identifier: main
      tls:
        - secretName: wildcard-thekor
          hosts:
            - immich.thekor.eu

# ── Machine Learning ──────────────────────────────────────────────────────────
machine-learning:
  enabled: true
  controllers:
    main:
      replicas: 1
      nodeSelector:
        node-role: slow-services
      containers:
        main:
          env:
            TZ: Europe/Berlin
            GUNICORN_CMD_ARGS: "--no-control-socket"
          image:
            tag: "v2.7.5"
          resources:
            requests:
              cpu: 200m
              memory: 2Gi
            limits:
              memory: 4Gi
          securityContext:
            runAsNonRoot: true
            runAsUser: 1000
  persistence:
    cache:
      enabled: true
      type: persistentVolumeClaim
      storageClass: "rook-cephfs"
      accessMode: ReadWriteMany
      size: 10Gi
    data:
      enabled: false
          
# ── Valkey ────────────────────────────────────────────────────────────────────
valkey:
  enabled: true
  controllers:
    main:
      containers:
        main:
          securityContext:
            runAsNonRoot: true
            runAsUser: 999
          image:
            repository: docker.io/valkey/valkey
            tag: 9.1-alpine@sha256:34f4f659e02a67cfdf3995d11ae432219c936005055b2cd39a042e86280e053e
            pullPolicy: IfNotPresent
  persistence:
    data:
      enabled: true
      type: persistentVolumeClaim
      storageClass: "rook-ceph-block"
      accessMode: ReadWriteOnce
      size: 1Gi