image:
  repository: technitium/dns-server
  tag: ""
  pullPolicy: IfNotPresent

replicaCount: 1

env:
  TZ: Europe/Berlin
  DNS_SERVER_DOMAIN: "{{ technitium_ingress_host }}"
  DNS_SERVER_ADMIN_PASSWORD_FILE: "/run/secrets/admin-password"
  DNS_SERVER_RECURSION: "AllowOnlyForPrivateNetworks"
  DNS_SERVER_QNAME_MINIMIZATION: "true"
  DNS_SERVER_DNSSEC_VALIDATION: "true"
  DNS_SERVER_ADMIN_PASSWORD_FILE: "/run/dns-secrets/admin-password"

# IMPORTANT: needed for port 53 on the node
hostNetwork: true
dnsPolicy: Default
service:
  main:
    enabled: true
    type: ClusterIP
    externalTrafficPolicy: null

    ports:
      http:
        enabled: true
        port: 5380
        targetPort: 5380
        protocol: TCP

      dns-udp:
        enabled: true
        port: 53
        targetPort: 53
        protocol: UDP

      dns-tcp:
        enabled: true
        port: 53
        targetPort: 53
        protocol: TCP

      https:
        enabled: false
      dhcp:
        enabled: false
      dot:
        enabled: false
      doh-reverse:
        enabled: false

ingress:
  main:
    enabled: true
    ingressClassName: haproxy
    annotations:
      cert-manager.io/cluster-issuer: "{{ technitium_clusterissuer }}"
    hosts:
      - host: "{{ technitium_ingress_host }}"
        paths:
          - path: /
            pathType: Prefix
    tls:
      - secretName: "{{ technitium_tls_name }}"
        hosts:
          - "{{ technitium_ingress_host }}"


persistence:
  config:
    enabled: true
    type: pvc
    storageClass: "{{ technitium_storage_class }}"
    accessMode: ReadWriteOnce
    size: "{{ technitium_storage_size }}"
    mountPath: /etc/dns
  admin-secret:
    enabled: true
    type: secret
    name: technitium-admin-secret
    mountPath: /run/dns-secrets
    readOnly: true
  mysql-config:
    enabled: true
    type: secret
    name: technitium-mysql-config
    mountPath: "/etc/dns/apps/Query Logs (MySQL)/dnsApp.config"
    subPath: dnsApp.config
    readOnly: true

resources:
  requests:
    memory: "128Mi"
  limits:
    memory: "512Mi"

nodeSelector:
  kubernetes.io/hostname: coreos-wk-4

tolerations:
  - key: "dedicated"
    operator: "Equal"
    value: "slow-services"
    effect: "NoSchedule"

securityContext: {}

podSecurityContext: {}